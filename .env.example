# Copy to .env and fill in your values. Do not commit .env (it is in .gitignore).

# Discord bot token (required to run the bot)
DISCORD_TOKEN=

# Optional: guild ID for instant slash-command sync on startup (global sync can take ~1 hour)
DISCORD_GUILD_ID=680569558754656280

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_AUTOCOMMIT=true

# Sync auth token (X-Auth-Token for sync API)
SYNC_AUTH=

# Webhook URLs
SCREENSHARES_WEBHOOK=
BUG_REPORT_WEBHOOK=

# Telegram bot (for utilities-reload check and sendmessage cog)
TELEGRAM_BOT_TOKEN=

# Google Sheets service account JSON path (for applications).
# If auth fails with "Invalid JWT Signature", regenerate the key in Google Cloud Console
# (IAM & Admin -> Service Accounts -> Keys) and replace this file.
GOOGLE_SHEETS_CREDENTIALS=

# Management audit log HTTP (account sync/unsync logs)
MANAGEMENT_LOG_API_SECRET=
MANAGEMENT_LOG_HTTP_URL=http://127.0.0.1:8766/api/logs
